AuthType Basic
AuthName "Restricted Area"
AuthUserFile /home/host831115/domains/reklamap.pl/reklamap/.htpasswd
Require valid-user

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
