# Force correct MIME types for static assets
<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js .mjs
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/gif .gif
  AddType application/xml .xml
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# index.html / spa-fallback.html must never be cached - odwołują się do hashowanych chunków
# zmienianych przy każdym deployu (stary cache → 404 zasobu → biała strona).
<FilesMatch "^(index|spa-fallback)\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# Cache control for static assets (safe because filenames include content hash)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>


<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.reklamap\.pl$ [NC]
  RewriteRule ^ https://reklamap.pl%{REQUEST_URI} [R=301,L]

  # Legacy URL → nowe ścieżki (twarde 301, żeby przekazać link equity i wyczyścić indeks).
  # Odpowiedniki istnieją też w router.ts jako fallback dla nawigacji wewnątrz SPA.
  RewriteRule ^dodaj-ogloszenie/?$ /dodaj-powierzchnie-reklamowa [R=301,L]
  RewriteRule ^ogloszenia/?$ /powierzchnie-reklamowe [R=301,L]
  RewriteRule ^ogloszenie/([^/]+)/([^/]+)/([0-9]+)/?$ /powierzchnia-reklamowa/inne/$1/$2-$3 [R=301,L]

  # Sitemapa: scripts/prerender.mjs zapisuje statyczny dist/sitemap.xml przy każdym
  # (udanym) buildzie, więc front serwuje ją sam z domeny kanonicznej — bez 301 na api,
  # odporne na awarie backendu. Gdyby statycznego pliku zabrakło (np. build bez prerenderu),
  # warunek !-f uruchamia fallback 301 na backend, by nie zgubić discovery ani nie oddać
  # botowi index.html (text/html) z SPA-fallbacku poniżej.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^sitemap\.xml$ https://api.reklamap.pl/sitemap.xml [R=301,L]

  # OG-shim (2026-06-09): scrapery social NIE renderują JS, więc dostają z SPA pusty
  # karton. Kierujemy je do og-meta.php, który wstrzykuje og:/twitter z danych ogłoszenia.
  # ŚWIADOMIE BEZ googlebot/bingbot — te renderują JS same (useSeo) i mają zostać na SPA.
  RewriteCond %{HTTP_USER_AGENT} facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|slack-imgproxy|whatsapp|vkshare|redditbot|pinterest|discordbot|telegrambot|embedly|skypeuripreview|nuzzel|bitlybot|flipboard|tumblr|mastodon|googlebot-image [NC]
  RewriteCond %{REQUEST_URI} !\.(js|css|xml|less|png|jpg|jpeg|gif|pdf|txt|ico|zip|mp3|mp4|webm|woff|woff2|ttf|svg|webp|json|webmanifest)$ [NC]
  RewriteCond %{REQUEST_URI} !^/og-meta\.php
  RewriteRule ^(.*)$ /og-meta.php?path=$1 [L,QSA]

  # Prerender BUILD-TIME (SEO, 2026-06-16): jeśli dla czystego URL-a istnieje wygenerowany
  # statyczny <path>/index.html (z scripts/prerender.mjs), serwuj go BEZ 301 na ukośnik,
  # przed SPA-fallbackiem. Dotyczy wszystkich (bot dostaje pełną treść, user i tak hydratuje).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # (Historyczne) Prerender RUNTIME wyłączony 2026-05-18 — prerender.io trial wygasł (429
  # => deindeks). Zastąpiony prerenderem build-time powyżej. prerender-proxy.php zostaje
  # w repo na wypadek powrotu do self-hosta; blok celowo zakomentowany.
  # RewriteCond %{HTTP_USER_AGENT} googlebot|adsbot-google|bingbot|yandex|applebot|duckduckbot [NC]
  # RewriteCond %{REQUEST_URI} !^/prerender-proxy\.php
  # RewriteRule ^(.*)$ /prerender-proxy.php?url=https://reklamap.pl/$1 [L,QSA]

  # Ogłoszenia (leaf) bez prerenderu: stary format sluga wymiarów sprzed 2026-06-15
  # (np. „billboard-504238-m-miasto-213” zamiast aktualnego „billboard-5-04-x-2-38-m-miasto-213")
  # lub ogłoszenie jeszcze nieujęte w ostatnim buildzie sitemapy. AdDetailPage.vue resolwuje
  # ogłoszenie po KOŃCOWYM {id} niezależnie od treści sluga (patrz loadAd(): id.split('-').pop())
  # i sama nadaje poprawny <link rel="canonical"> na aktualny slug oraz noindex tylko przy
  # realnym 404. Bez tej reguły takie URL-e trafiały do noindex-owego spa-fallback.html poniżej,
  # więc GSC raportował aktywne, sprzedażowe ogłoszenia jako „wykluczone przez tag noindex"
  # (naprawa 2026-07-28, zob. CLAUDE.md → SEO, Sitemap i Deploy).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^powierzchnia-reklamowa/[^/]+/[^/]+/[^/]+-[0-9]+/?$ /index.html [L]

  # SPA fallback — trasy BEZ prerenderu (nieznane/usunięte/funkcyjne jak /porownaj, /zarzadzaj)
  # dostają NOINDEX-owy szkielet (spa-fallback.html), NIE zaseedowaną home. Eliminuje soft-404:
  # śmieciowy/martwy URL nie jest już serwowany jako 200 + `index` z treścią home (duplikat home).
  # Każda indeksowalna trasa ma własny prerenderowany <path>/index.html (obsłużony wyżej), więc tu
  # trafia wyłącznie to, co ma NIE być indeksowane. HTTP zostaje 200 (SPA wymaga tego dla routingu
  # po stronie klienta) — sygnałem dla Google jest `noindex` w szkielecie.
  RewriteRule ^(index|spa-fallback)\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/spa-fallback.html -f
  RewriteRule . /spa-fallback.html [L]
  # Degradacja bezpieczeństwa: gdy spa-fallback.html nie istnieje (np. build bez prerenderu),
  # serwuj index.html, żeby SPA dalej działała na deep-linkach (lepiej `index` niż biała strona).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
