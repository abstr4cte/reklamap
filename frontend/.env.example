# Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_INTERNAL_APP_KEY=your-internal-app-key-here

# reCAPTCHA v3 Configuration
# Get your keys from: https://www.google.com/recaptcha/admin
# 1. Go to https://www.google.com/recaptcha/admin
# 2. Create a new site with reCAPTCHA v3
# 3. Copy the Site Key and Secret Key
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here

# Sentry Error Tracking Configuration
# Get your DSN from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=https://7d54d9c7bcc6aca5a230c7fb43500c84@o4511198368104448.ingest.de.sentry.io/4511198394777680
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Microsoft Clarity (heatmapy + nagrania sesji, darmowe)
# ID projektu z https://clarity.microsoft.com (Settings → Overview → Project ID).
# Puste = Clarity się nie ładuje. Skrypt nie odpala się też dla botów i prerenderu.
VITE_CLARITY_ID=

# Supabase Configuration (if needed)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
